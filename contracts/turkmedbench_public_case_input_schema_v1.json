{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:turkmedbench:contracts:public-case-input:v1",
  "title": "TurKMedBench Public Case Input Schema v1",
  "description": "Model input contract. It intentionally excludes scoring keys, source records, and adjudication decisions.",
  "x-turkmedbench-local-implementation-policy": {
    "path": "data/contracts/turkmedbench_local_implementation_policy_v1.json",
    "policy_version": "local_implementation_policy.v1"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "project",
    "schema_version",
    "case_id",
    "visibility",
    "specialty",
    "language_context",
    "local_implementation_context",
    "care_setting",
    "acuity_band",
    "task",
    "case_input",
    "safety_boundary",
    "synthetic_provenance"
  ],
  "properties": {
    "project": {
      "const": "TurKMedBench"
    },
    "schema_version": {
      "const": "public_case_input.v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^TMB-[A-Z0-9]{2,8}-[A-Z0-9]{2,12}-[0-9]{3}$"
    },
    "visibility": {
      "const": "public_model_input"
    },
    "specialty": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,39}$"
    },
    "subspecialty": {
      "type": "string",
      "minLength": 2
    },
    "language_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_language", "country_context", "local_implementation_dimensions"],
      "properties": {
        "response_language": {
          "enum": ["tr", "en", "bilingual"]
        },
        "country_context": {
          "const": "TR"
        },
        "local_implementation_dimensions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "enum": [
              "health_system_pathway",
              "medication_availability",
              "reimbursement_verification",
              "referral_pathway",
              "communication_context"
            ]
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "properties": {
            "local_implementation_dimensions": {
              "contains": {"const": "health_system_pathway"}
            }
          }
        },
        {
          "properties": {
            "local_implementation_dimensions": {
              "contains": {"const": "referral_pathway"}
            }
          }
        }
      ]
    },
    "local_implementation_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdiction",
        "care_level",
        "pathway_verification_status",
        "capacity_status",
        "referral_target_status",
        "evidence_boundary"
      ],
      "properties": {
        "jurisdiction": {
          "const": "TR"
        },
        "care_level": {
          "enum": [
            "primary_care",
            "outpatient_care_level_requires_verification",
            "emergency_service",
            "inpatient_service",
            "intensive_care",
            "telehealth_care",
            "mixed_care_level_requires_verification"
          ]
        },
        "pathway_verification_status": {
          "enum": [
            "not_provided_in_public_input",
            "restricted_source_chain_pending",
            "restricted_source_chain_verified"
          ]
        },
        "capacity_status": {
          "enum": [
            "not_claimed_requires_current_verification",
            "verified_in_restricted_source_chain"
          ]
        },
        "referral_target_status": {
          "enum": [
            "must_be_identified_by_model_and_clinical_oversight",
            "emergency_receiving_team_must_be_verified",
            "specialist_team_must_be_verified"
          ]
        },
        "evidence_boundary": {
          "const": "current_official_or_institutional_verification_required"
        }
      }
    },
    "care_setting": {
      "enum": [
        "primary_care",
        "outpatient",
        "emergency",
        "inpatient",
        "icu",
        "telehealth",
        "mixed"
      ]
    },
    "acuity_band": {
      "enum": ["routine", "time_sensitive", "urgent", "emergency", "not_applicable"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_type", "question", "required_output_sections"],
      "properties": {
        "task_type": {
          "enum": [
            "diagnosis",
            "triage",
            "treatment",
            "medication_safety",
            "discharge",
            "referral",
            "patient_communication",
            "documentation",
            "guideline_compliance",
            "other"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 20
        },
        "required_output_sections": {
          "type": "array",
          "minItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "primary_recommendation",
              "clinical_rationale",
              "missing_information",
              "safety_and_harm_warnings",
              "local_implementability",
              "referral_or_escalation",
              "evidence_and_source_limits",
              "confidence"
            ]
          }
        }
      },
      "allOf": [
        {
          "properties": {
            "required_output_sections": {
              "contains": {"const": "safety_and_harm_warnings"}
            }
          }
        },
        {
          "properties": {
            "required_output_sections": {
              "contains": {"const": "local_implementability"}
            }
          }
        },
        {
          "properties": {
            "required_output_sections": {
              "contains": {"const": "evidence_and_source_limits"}
            }
          }
        }
      ]
    },
    "case_input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic",
        "patient_data_status",
        "demographics",
        "clinical_presentation",
        "constraints"
      ],
      "properties": {
        "synthetic": {
          "const": true
        },
        "patient_data_status": {
          "const": "no_patient_level_data"
        },
        "demographics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["age_band", "sex_context"],
          "properties": {
            "age_band": {
              "enum": ["pediatric", "young_adult", "adult", "older_adult", "not_specified"]
            },
            "sex_context": {
              "enum": ["female", "male", "intersex", "not_specified", "not_applicable"]
            },
            "pregnancy_context": {
              "enum": ["pregnant", "not_pregnant", "unknown", "not_applicable"]
            }
          }
        },
        "clinical_presentation": {
          "type": "string",
          "minLength": 20
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "medications": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "investigations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        }
      }
    },
    "safety_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clinical_use_prohibited", "human_review_required"],
      "properties": {
        "clinical_use_prohibited": {
          "const": true
        },
        "human_review_required": {
          "const": true
        }
      }
    },
    "synthetic_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation_method",
        "phi_screen_status",
        "near_duplicate_check",
        "legacy_overlap_check"
      ],
      "properties": {
        "generation_method": {
          "enum": ["human_authored", "template_based", "model_assisted_human_edited"]
        },
        "phi_screen_status": {
          "const": "complete_no_patient_level_data"
        },
        "near_duplicate_check": {
          "enum": ["complete_no_match", "complete_match_reviewed"]
        },
        "legacy_overlap_check": {
          "enum": ["complete_no_match", "complete_match_mapped"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"care_setting": {"const": "primary_care"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "primary_care"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "outpatient"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "outpatient_care_level_requires_verification"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "emergency"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "emergency_service"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "inpatient"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "inpatient_service"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "icu"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "intensive_care"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "telehealth"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "telehealth_care"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"care_setting": {"const": "mixed"}}
      },
      "then": {
        "properties": {
          "local_implementation_context": {
            "properties": {"care_level": {"const": "mixed_care_level_requires_verification"}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "task_type": {"const": "medication_safety"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "language_context": {
            "properties": {
              "local_implementation_dimensions": {
                "allOf": [
                  {"contains": {"const": "medication_availability"}},
                  {"contains": {"const": "reimbursement_verification"}}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "task": {
            "properties": {
              "task_type": {"const": "patient_communication"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "language_context": {
            "properties": {
              "local_implementation_dimensions": {
                "contains": {"const": "communication_context"}
              }
            }
          }
        }
      }
    }
  ]
}
